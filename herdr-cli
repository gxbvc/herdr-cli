#!/usr/bin/env python3
"""Talk to herdr in workspaces and tabs. Panes stay internal."""

from __future__ import annotations

import json
import os
import re
import socket
import subprocess
import sys
import time

HERDR = os.environ.get("HERDR", "herdr")
BUSY = ("agent_pane_busy", "agent_not_ready")
TAB_ID = re.compile(r"^w[0-9A-Za-z]+:t\S+$")
STAR = "\u2b50"

USAGE = """\
Usage:
  herdr-cli workspaces
  herdr-cli tabs [--workspace ID|label]
  herdr-cli spawn <name> --workspace ID|label [--kind KIND] [--cwd PATH] [--label TEXT] [--index N]
  herdr-cli start <name> --tab TAB_ID [--kind KIND]
  herdr-cli send <tab|name> [--file PATH] [--wait] [--timeout MS] [--until STATUS] [text...]
  herdr-cli read <tab|name> [--lines N] [--source SOURCE]
  herdr-cli wait <tab|name> [--until STATUS] [--timeout MS]
  herdr-cli ask <tab|name> [--file PATH] [--timeout MS] [--until STATUS] [text...]
  herdr-cli star <tab|name>... | unstar <tab|name>... | unstar --all [--workspace ID|label]
  herdr-cli rename <tab|name> <label>
  herdr-cli move <tab|name> --index N
  herdr-cli move-workspace <ID|label> --index N
  herdr-cli status [--workspace ID|label] [--stale-hours N] [--questions] [--pretty]

The unit is a tab in a workspace. Prompt text comes from --file, args, or stdin
and is passed to herdr as one argv element, so leading # and -- are safe.
Default --kind is pi. spawn always uses --no-focus. A star is a leading star
emoji on the tab label (pios reads the same prefix). Index 0 is leftmost.
"""


class HerdrError(Exception):
    def __init__(self, message, code="HERDR"):
        super().__init__(message)
        self.code = code


def emit_ok(data):
    sys.stdout.write(json.dumps({"ok": True, "data": data}, separators=(",", ":")) + "\n")
    return 0


def emit_err(message, code="ERROR"):
    sys.stdout.write(json.dumps({"ok": False, "error": message, "code": code}, separators=(",", ":")) + "\n")
    return 1


def take_flag(args, name, takes_value=False):
    if name not in args:
        return args, None
    i = args.index(name)
    if not takes_value:
        return args[:i] + args[i + 1 :], True
    if i + 1 >= len(args):
        raise HerdrError(f"{name} needs a value", "USAGE")
    return args[:i] + args[i + 2 :], args[i + 1]


def herdr(argv, timeout=None):
    try:
        completed = subprocess.run(
            [HERDR, *argv],
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except FileNotFoundError as error:
        raise HerdrError(f"herdr not found: {error}", "HERDR_MISSING") from error
    except subprocess.TimeoutExpired as error:
        raise HerdrError(f"herdr timed out: {' '.join(argv)}", "TIMEOUT") from error
    err = (completed.stderr or "").strip()
    out = (completed.stdout or "").strip()
    if completed.returncode != 0:
        blob = err or out or f"herdr exited {completed.returncode}"
        code = "BUSY" if any(token in blob for token in BUSY) else "HERDR"
        for text in (err, out):
            if not text:
                continue
            try:
                parsed = json.loads(text)
            except json.JSONDecodeError:
                continue
            error = parsed.get("error") or {}
            if error.get("code") in BUSY:
                code = "BUSY"
            blob = error.get("message") or blob
        raise HerdrError(blob, code)
    if not out:
        return {}
    try:
        payload = json.loads(out)
    except json.JSONDecodeError:
        return {"raw": out}
    if isinstance(payload, dict) and "result" in payload:
        return payload["result"]
    return payload


def socket_call(method, params):
    """Raw socket API call for methods the herdr CLI does not expose (tab.move, workspace.move)."""
    path = os.environ.get("HERDR_SOCKET_PATH") or os.path.expanduser("~/.config/herdr/herdr.sock")
    request = {"id": f"herdr-cli-{os.getpid()}", "method": method, "params": params}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(10)
            sock.connect(path)
            sock.sendall((json.dumps(request) + "\n").encode())
            buffer = b""
            while b"\n" not in buffer:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buffer += chunk
    except OSError as error:
        raise HerdrError(f"herdr socket: {error}", "HERDR_MISSING") from error
    response = json.loads(buffer.split(b"\n", 1)[0] or b"{}")
    if "error" in response:
        error = response["error"] or {}
        raise HerdrError(error.get("message") or str(error), error.get("code") or "HERDR")
    return response.get("result") or {}


def prompt_argv(target, text, wait=False, timeout=None, until=None):
    argv = ["agent", "prompt", target, text]
    if wait:
        argv.append("--wait")
    if until:
        for status in until if isinstance(until, list) else [until]:
            argv.extend(["--until", status])
    if timeout:
        argv.extend(["--timeout", str(timeout)])
    return argv


def tab_create_argv(workspace_id, cwd=None, label=None):
    argv = ["tab", "create", "--workspace", workspace_id, "--no-focus"]
    if cwd:
        argv.extend(["--cwd", cwd])
    if label:
        argv.extend(["--label", label])
    return argv


def pane_from_list(panes, tab_id):
    hits = [pane for pane in panes if pane.get("tab_id") == tab_id]
    if not hits:
        raise HerdrError(f"no terminal in tab {tab_id}", "NOT_FOUND")
    if len(hits) > 1:
        named = [pane for pane in hits if pane.get("agent") or pane.get("name")]
        hits = named or hits
    return hits[0]


def public_tab(tab, pane=None, agent=None):
    pane = pane or {}
    agent = agent or {}
    return {
        "workspace_id": tab.get("workspace_id") or pane.get("workspace_id"),
        "tab_id": tab.get("tab_id") or pane.get("tab_id"),
        "label": tab.get("label"),
        "cwd": pane.get("cwd") or agent.get("cwd"),
        "kind": agent.get("agent") or pane.get("agent"),
        "name": agent.get("name"),
        "status": tab.get("agent_status") or agent.get("agent_status") or pane.get("agent_status"),
    }


def read_prompt(args):
    args, path = take_flag(args, "--file", True)
    if path:
        with open(path, encoding="utf-8") as handle:
            return args, handle.read()
    if args:
        return [], " ".join(args)
    if sys.stdin.isatty():
        raise HerdrError("prompt text required via --file, args, or stdin", "USAGE")
    return [], sys.stdin.read()


def workspaces():
    return herdr(["workspace", "list"]).get("workspaces") or []


def resolve_workspace(token):
    for workspace in workspaces():
        if token in (workspace.get("workspace_id"), workspace.get("label")):
            return workspace
    raise HerdrError(f"workspace not found: {token}", "NOT_FOUND")


def panes_in_workspace(workspace_id=None):
    argv = ["pane", "list"]
    if workspace_id:
        argv.extend(["--workspace", workspace_id])
    return herdr(argv).get("panes") or []


def pane_for_tab(tab_id):
    workspace_id = tab_id.split(":", 1)[0] if ":" in tab_id else None
    return pane_from_list(panes_in_workspace(workspace_id), tab_id)


def agents():
    return herdr(["agent", "list"]).get("agents") or []


def resolve_target(target):
    for agent in agents():
        if target in (agent.get("name"), agent.get("tab_id")):
            return agent.get("name") or agent["pane_id"]
    if TAB_ID.match(target):
        return pane_for_tab(target)["pane_id"]
    return target


def resolve_tab_id(target):
    """Tab id from a tab id or an agent name."""
    if TAB_ID.match(target):
        return target
    for agent in agents():
        if target == agent.get("name"):
            return agent["tab_id"]
    raise HerdrError(f"no tab or agent named {target}", "NOT_FOUND")


def tab_info(tab_id):
    return herdr(["tab", "get", tab_id]).get("tab") or {}


def strip_star(label):
    return re.sub(rf"^{STAR}\s*", "", label or "")


def start_on_pane(name, kind, pane_id, retries=10, delay_ms=500, timeout=None, extra=None):
    argv = ["agent", "start", name, "--kind", kind, "--pane", pane_id]
    if timeout:
        argv.extend(["--timeout", str(timeout)])
    if extra:
        argv.append("--")
        argv.extend(extra)
    last = None
    for attempt in range(retries):
        try:
            return herdr(argv)
        except HerdrError as error:
            last = error
            if error.code != "BUSY" or attempt == retries - 1:
                raise
            time.sleep(delay_ms / 1000)
    raise last


def cmd_workspaces(_args):
    rows = [
        {
            "workspace_id": workspace.get("workspace_id"),
            "label": workspace.get("label"),
            "tab_count": workspace.get("tab_count"),
        }
        for workspace in workspaces()
    ]
    return emit_ok({"workspaces": rows})


def cmd_tabs(args):
    args, token = take_flag(args, "--workspace", True)
    workspace_id = resolve_workspace(token)["workspace_id"] if token else None
    tab_argv = ["tab", "list"]
    if workspace_id:
        tab_argv.extend(["--workspace", workspace_id])
    tabs = herdr(tab_argv).get("tabs") or []
    pane_map = {}
    for pane in panes_in_workspace(workspace_id):
        pane_map.setdefault(pane.get("tab_id"), pane)
    agent_map = {agent.get("tab_id"): agent for agent in agents()}
    rows = [
        public_tab(tab, pane_map.get(tab.get("tab_id")), agent_map.get(tab.get("tab_id")))
        for tab in tabs
    ]
    return emit_ok({"tabs": rows})


def cmd_spawn(args):
    args, workspace = take_flag(args, "--workspace", True)
    args, kind = take_flag(args, "--kind", True)
    args, cwd = take_flag(args, "--cwd", True)
    args, label = take_flag(args, "--label", True)
    args, index = take_flag(args, "--index", True)
    extra = []
    if "--" in args:
        i = args.index("--")
        extra = args[i + 1 :]
        args = args[:i]
    if not args:
        raise HerdrError("spawn needs a name", "USAGE")
    if not workspace:
        raise HerdrError("spawn needs --workspace", "USAGE")
    name = args[0]
    kind = kind or "pi"
    workspace_id = resolve_workspace(workspace)["workspace_id"]
    created = herdr(tab_create_argv(workspace_id, cwd=cwd, label=label or name))
    tab = created.get("tab") or {}
    root = created.get("root_pane") or {}
    pane_id = root.get("pane_id")
    tab_id = tab.get("tab_id")
    if not pane_id:
        if not tab_id:
            raise HerdrError("tab create did not return a tab", "HERDR")
        pane_id = pane_for_tab(tab_id)["pane_id"]
    start_on_pane(name, kind, pane_id, extra=extra)
    if index is not None and tab_id:
        socket_call("tab.move", {"tab_id": tab_id, "insert_index": int(index)})
    return emit_ok({
        "workspace_id": workspace_id,
        "tab_id": tab_id,
        "label": tab.get("label") or label or name,
        "name": name,
        "kind": kind,
        "cwd": cwd,
    })


def cmd_start(args):
    args, kind = take_flag(args, "--kind", True)
    args, tab_id = take_flag(args, "--tab", True)
    extra = []
    if "--" in args:
        i = args.index("--")
        extra = args[i + 1 :]
        args = args[:i]
    if not args:
        raise HerdrError("start needs a name", "USAGE")
    if not tab_id:
        raise HerdrError("start needs --tab", "USAGE")
    name = args[0]
    pane_id = pane_for_tab(tab_id)["pane_id"]
    start_on_pane(name, kind or "pi", pane_id, extra=extra)
    return emit_ok({"tab_id": tab_id, "name": name, "kind": kind or "pi"})


def cmd_send(args):
    args, wait = take_flag(args, "--wait")
    args, timeout = take_flag(args, "--timeout", True)
    until = []
    while "--until" in args:
        args, status = take_flag(args, "--until", True)
        until.append(status)
    if not args:
        raise HerdrError("send needs a tab or name", "USAGE")
    target, args = args[0], args[1:]
    args, text = read_prompt(args)
    if not text:
        raise HerdrError("prompt text is empty", "USAGE")
    payload = herdr(
        prompt_argv(resolve_target(target), text, wait=bool(wait), timeout=timeout, until=until or None)
    )
    return emit_ok(payload)


def cmd_read(args):
    args, lines = take_flag(args, "--lines", True)
    args, source = take_flag(args, "--source", True)
    if not args:
        raise HerdrError("read needs a tab or name", "USAGE")
    argv = ["agent", "read", resolve_target(args[0])]
    if source:
        argv.extend(["--source", source])
    if lines:
        argv.extend(["--lines", lines])
    return emit_ok(herdr(argv))


def cmd_wait(args):
    args, timeout = take_flag(args, "--timeout", True)
    until = []
    while "--until" in args:
        args, status = take_flag(args, "--until", True)
        until.append(status)
    if not args:
        raise HerdrError("wait needs a tab or name", "USAGE")
    argv = ["agent", "wait", resolve_target(args[0])]
    for status in until:
        argv.extend(["--until", status])
    if timeout:
        argv.extend(["--timeout", timeout])
    return emit_ok(herdr(argv))


def cmd_ask(args):
    args, timeout = take_flag(args, "--timeout", True)
    until = []
    while "--until" in args:
        args, status = take_flag(args, "--until", True)
        until.append(status)
    if not args:
        raise HerdrError("ask needs a tab or name", "USAGE")
    target, args = args[0], args[1:]
    args, text = read_prompt(args)
    if not text:
        raise HerdrError("prompt text is empty", "USAGE")
    resolved = resolve_target(target)
    statuses = until or ["idle", "done", "blocked"]
    send_payload = herdr(prompt_argv(resolved, text, wait=True, timeout=timeout, until=statuses))
    read_payload = herdr(["agent", "read", resolved, "--source", "recent-unwrapped"])
    return emit_ok({"status": send_payload, "reply": read_payload})


def set_star(tab_id, starred):
    label = tab_info(tab_id).get("label") or ""
    bare = strip_star(label)
    wanted = f"{STAR} {bare}" if starred else bare
    if wanted != label:
        herdr(["tab", "rename", tab_id, wanted])
    return {"tab_id": tab_id, "label": wanted, "starred": starred, "changed": wanted != label}


def cmd_star(args, starred=True):
    args, every = take_flag(args, "--all")
    args, workspace = take_flag(args, "--workspace", True)
    if every:
        if starred:
            raise HerdrError("--all only works with unstar", "USAGE")
        argv = ["tab", "list"]
        if workspace:
            argv.extend(["--workspace", resolve_workspace(workspace)["workspace_id"]])
        targets = [t["tab_id"] for t in herdr(argv).get("tabs") or [] if (t.get("label") or "").startswith(STAR)]
    else:
        if not args:
            raise HerdrError("star needs a tab or name", "USAGE")
        targets = [resolve_tab_id(arg) for arg in args]
    return emit_ok({"tabs": [set_star(tab_id, starred) for tab_id in targets]})


def cmd_unstar(args):
    return cmd_star(args, starred=False)


def cmd_rename(args):
    if len(args) < 2:
        raise HerdrError("rename needs a tab and a label", "USAGE")
    tab_id = resolve_tab_id(args[0])
    herdr(["tab", "rename", tab_id, " ".join(args[1:])])
    return emit_ok({"tab_id": tab_id, "label": " ".join(args[1:])})


def cmd_move(args):
    args, index = take_flag(args, "--index", True)
    if not args or index is None:
        raise HerdrError("move needs a tab and --index N", "USAGE")
    tab_id = resolve_tab_id(args[0])
    socket_call("tab.move", {"tab_id": tab_id, "insert_index": int(index)})
    return emit_ok({"tab_id": tab_id, "index": int(index)})


def cmd_move_workspace(args):
    args, index = take_flag(args, "--index", True)
    if not args or index is None:
        raise HerdrError("move-workspace needs a workspace and --index N", "USAGE")
    workspace_id = resolve_workspace(args[0])["workspace_id"]
    socket_call("workspace.move", {"workspace_id": workspace_id, "insert_index": int(index)})
    return emit_ok({"workspace_id": workspace_id, "index": int(index)})


def session_facts(path):
    """Deterministic facts from a pi session file. No LLM."""
    facts = {"idle_hours": None, "ends_with_question": False, "last_user_at": None,
             "last_assistant_at": None, "context_tokens": None, "last_assistant_tail": None}
    if not path or not os.path.exists(path):
        return facts
    facts["idle_hours"] = round((time.time() - os.path.getmtime(path)) / 3600, 1)
    last_text = ""
    with open(path, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if '"type":"message"' not in line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            message = record.get("message") or {}
            role = message.get("role")
            content = message.get("content")
            if isinstance(content, str):
                text = content
            else:
                text = "\n".join(c.get("text", "") for c in content or [] if isinstance(c, dict) and c.get("type") == "text")
            if role == "user" and text.strip() and not text.startswith("Subagent progress"):
                facts["last_user_at"] = record.get("timestamp")
            elif role == "assistant":
                usage = message.get("usage") or {}
                if usage.get("totalTokens"):
                    facts["context_tokens"] = usage["totalTokens"]
                if text.strip():
                    last_text = text.strip()
                    facts["last_assistant_at"] = record.get("timestamp")
    facts["ends_with_question"] = last_text.rstrip("*_ )\n").endswith("?")
    facts["last_assistant_tail"] = last_text[-300:] if last_text else None
    return facts


def cmd_status(args):
    args, workspace = take_flag(args, "--workspace", True)
    args, stale = take_flag(args, "--stale-hours", True)
    args, questions = take_flag(args, "--questions")
    args, pretty = take_flag(args, "--pretty")
    spaces = {w["workspace_id"]: w for w in workspaces()}
    wanted = resolve_workspace(workspace)["workspace_id"] if workspace else None
    labels = {}
    for workspace_id in ([wanted] if wanted else spaces):
        for index, tab in enumerate(herdr(["tab", "list", "--workspace", workspace_id]).get("tabs") or []):
            labels[tab["tab_id"]] = (index, tab.get("label") or "")
    rows = []
    for agent in agents():
        if agent.get("tab_id") not in labels:
            continue
        index, label = labels[agent["tab_id"]]
        facts = session_facts((agent.get("agent_session") or {}).get("value"))
        row = {
            "workspace": spaces.get(agent["workspace_id"], {}).get("label"),
            "workspace_id": agent["workspace_id"],
            "tab_id": agent["tab_id"],
            "index": index,
            "label": label,
            "starred": label.startswith(STAR),
            "name": agent.get("name"),
            "status": agent.get("agent_status"),
            "cwd": agent.get("cwd"),
            "session": (agent.get("agent_session") or {}).get("value"),
            **facts,
        }
        if stale and (row["idle_hours"] is None or row["idle_hours"] < float(stale)):
            continue
        if questions and not row["ends_with_question"]:
            continue
        rows.append(row)
    rows.sort(key=lambda r: (r["workspace_id"], r["index"]))
    if pretty:
        for r in rows:
            idle = f"{r['idle_hours']:6.1f}h" if r["idle_hours"] is not None else "    n/a"
            ctx = f"{(r['context_tokens'] or 0) // 1000:4d}k"
            q = "?" if r["ends_with_question"] else " "
            sys.stdout.write(f"{(r['workspace'] or '')[:12]:12} {r['tab_id']:9} {idle} {ctx} {r['status'] or '':8} {q} {r['label']}\n")
        return 0
    return emit_ok({"tabs": rows})


COMMANDS = {
    "workspaces": cmd_workspaces,
    "tabs": cmd_tabs,
    "list": cmd_tabs,
    "spawn": cmd_spawn,
    "start": cmd_start,
    "send": cmd_send,
    "read": cmd_read,
    "wait": cmd_wait,
    "ask": cmd_ask,
    "star": cmd_star,
    "unstar": cmd_unstar,
    "rename": cmd_rename,
    "move": cmd_move,
    "move-workspace": cmd_move_workspace,
    "status": cmd_status,
}


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    handler = COMMANDS.get(argv[0])
    if handler is None:
        return emit_err(f"unknown command: {argv[0]}", "USAGE")
    try:
        return handler(argv[1:])
    except HerdrError as error:
        return emit_err(str(error), error.code)
    except OSError as error:
        return emit_err(str(error), "IO")


if __name__ == "__main__":
    sys.exit(main())
